{
  "name": "claude-os-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for Jason's claude-os memory system",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "reembed": "tsx src/scripts/reembed.ts",
    "eval": "tsx src/scripts/eval.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "cutover": "tsx src/scripts/cutover.ts",
    "doctor": "tsx src/scripts/doctor.ts",
    "graph:build": "tsx src/scripts/graph-build.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "chokidar": "^4.0.0",
    "gray-matter": "^4.0.3",
    "sqlite-vec": "latest",
    "ts-morph": "^28.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
