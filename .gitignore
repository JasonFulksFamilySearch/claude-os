# Belt and suspenders — data must NEVER end up in this repo
../.claude-data/
.claude-data/

# Environment / secrets — never commit
.env
.env.*
*.key
*.pem
secrets/
credentials/

# Anything that smells like a token
*token*
*secret*
*credentials*
# ...but token-auditor is a legitimate agent definition, not a secret. Exempt it
# so the broad *token* guard above stops masking it.
!agents/token-auditor.md

# Claude Code scratch files (plans, tasks — not portable system code)
.claude/

# Transient scratch files (the _tmp_ prefix convention) — never portable system
# code; ignored so a stray scratch file can't leak into a commit or transmit.
_tmp_*
**/_tmp_*

# Per-machine personality drafts kept at repo root — machine-local "soul" that
# must never propagate via the shared repo. Same leak-guard rationale as above.
personality-*-draft.md

# OS / editor cruft
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Python (for Phase 2+)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# Node (in case any tooling shows up)
node_modules/
package-lock.json
# mcp/package-lock.json is committed on purpose: it is the reproducible-install
# source for the CI gate (npm ci in .github/workflows/ci.yml). Keep it tracked.

# Logs
*.log

# Generated skill output (data artifacts, not system code)
skills/daily-action/plans/

# Dioscuri code-graph artifact — throwaway, rebuildable, per-repo. NEVER committed:
# it carries a build-commit stamp + machine-built reach/contract index that rebuilds
# from source. The contracts.json INPUT (a per-repo definition) stays tracked; only
# the generated graph/ output is ignored.
.dioscuri/graph/
**/.dioscuri/graph/

# Machine-local config (generated from *.template.json by install.sh)
config/watched-projects.json
config/episodes.json

# Note: the live eval labeled set is NOT here — it is machine-local DATA stored
# outside the repo at ~/.claude-data/eval/labeled-queries.json (provisioned from
# mcp/eval/labeled-queries.template.json by update.sh Step 2.6), so no ignore is needed.

# Override user-global ignore that masks the tracked docs/ directory
!docs/
!docs/**

# Re-ignore OS cruft inside the un-ignored docs/ tree — the .DS_Store rule
# above is defeated by !docs/** for anything under docs/, so re-exclude it here.
docs/.DS_Store
docs/**/.DS_Store

# Re-ignore red-blue-judge gate scratch inside docs/ — transient verification
# cycle artifacts, not portable system code. Force-tracked by !docs/** otherwise.
docs/**/.rbj/
